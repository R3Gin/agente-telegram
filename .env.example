# ===== Obrigatório =====

# Token do bot NOVO (crie no @BotFather). Não use o token do bot antigo.
TELEGRAM_BOT_TOKEN=

# Seu ID numérico do Telegram (pode copiar do .env do bot antigo). Vários: separe por vírgula.
ALLOWED_TELEGRAM_IDS=

# Pasta onde o Claude trabalha (arquivos que ele cria; "recebidos/" fica aqui dentro).
AGENT_CWD=/home/rmthost/agente

# ===== Claude =====

# Modelo e esforço padrão (dá para trocar no ⚙️ Painel).
# Modelos: haiku | sonnet | opus | fable    Esforço: low | medium | high | xhigh | max
DEFAULT_MODEL=sonnet
DEFAULT_EFFORT=low

# Limite de segurança de etapas por pedido. Ao chegar nele, o bot pergunta se continua.
MAX_TURNS=80

# Quando pedir sua confirmação: risky (só ações perigosas) | writes (tudo que altera) | off
CONFIRM_MODE=risky

# Caminho do claude. Vazio = usa o que vem com o SDK (mesma versão).
# Se o instalador disser que ele não roda nesta CPU, use o instalado: /root/.local/bin/claude
CLAUDE_BIN=

# Sugestão de próxima pergunta (botão 💡) depois de cada resposta.
PROMPT_SUGGESTIONS=true

# ===== Exibição =====

# draft = rascunho nativo do Telegram (recomendado) | edit = edita uma mensagem
STREAM_MODE=draft

# Depois de X horas parado, o próximo pedido começa uma conversa nova (0 = nunca).
AUTO_NEW_SESSION_HOURS=6

# Avisos de demora (minutos)
LONG_TASK_NOTICE_MIN=5
STALL_MIN=10

# ===== Áudio (whisper.cpp) =====

WHISPER_CLI=/home/rmthost/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=/home/rmthost/agente-telegram/models/ggml-tiny-q5_1.bin
WHISPER_LANGUAGE=pt
WHISPER_THREADS=2
# auto = em áudios curtos processa só o trecho útil (mais rápido). 0 = desliga.
WHISPER_AUDIO_CTX=auto

# ===== Outros =====

DATA_DIR=/home/rmthost/agente-telegram/data
LOG_LEVEL=info
TZ=America/Sao_Paulo
